# 学习数据库（首次运行自动创建，绝不入库——含个人学习记录与力扣会话）
/data/*.db
/data/*.db-journal
/data/*.db-wal
/data/*.db-shm
/data/*.sqlite*
/data/backups/
# 多用户学习库（每用户一库，含个人学习记录，绝不入库）
/data/users/
# 增量构建缓存（可再生，不入库）
/.build-cache.json
# 本地对端维护文档（个人运维信息，不入库）
/.maintenance/
# Python 字节码缓存（可再生，不入库）
__pycache__/
*.pyc
# 本地密钥文件（演示环境变量，禁止入库）
**/.env
*.env
!.env.example

# demo 演示数据库（含聊天记录，禁止入库）
books/**/*.db
books/**/*.db-wal
books/**/*.db-shm


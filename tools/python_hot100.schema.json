{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://interviewforge.local/schemas/python_hot100.schema.json",
  "title": "Interview Forge Python Hot 100 curriculum",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "language", "problems"],
  "properties": {
    "schema_version": {"const": 1},
    "language": {"const": "python"},
    "problems": {
      "type": "object",
      "minProperties": 100,
      "propertyNames": {"pattern": "^[1-9][0-9]*$"},
      "additionalProperties": {"$ref": "#/$defs/problem"}
    }
  },
  "$defs": {
    "problem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "method",
        "time",
        "space",
        "invariant",
        "why_this_approach",
        "derivation",
        "api_hints",
        "pitfalls",
        "complexity_reason",
        "code",
        "tests",
        "teaching_markdown",
        "explanation_markdown",
        "source",
        "source_note",
        "revision_notes"
      ],
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "method": {"type": "string", "minLength": 1},
        "time": {"type": "string", "minLength": 1},
        "space": {"type": "string", "minLength": 1},
        "invariant": {"type": "string", "minLength": 1},
        "why_this_approach": {"type": "string", "minLength": 1},
        "derivation": {
          "type": "array",
          "minItems": 3,
          "items": {"type": "string", "minLength": 1}
        },
        "api_hints": {
          "type": "array",
          "minItems": 2,
          "items": {"$ref": "#/$defs/api_hint"}
        },
        "pitfalls": {
          "type": "array",
          "minItems": 2,
          "items": {"type": "string", "minLength": 1}
        },
        "complexity_reason": {"type": "string", "minLength": 1},
        "code": {"type": "string", "minLength": 1},
        "teaching_markdown": {"type": "string", "minLength": 1},
        "explanation_markdown": {"type": "string", "minLength": 1},
        "source": {"type": "string", "minLength": 1},
        "source_note": {"type": "string", "minLength": 1},
        "revision_notes": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "tests": {
          "type": "array",
          "minItems": 2,
          "items": {"$ref": "#/$defs/test"}
        }
      }
    },
    "api_hint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["symbol", "syntax", "use"],
      "properties": {
        "symbol": {"type": "string", "minLength": 1},
        "syntax": {"type": "string", "minLength": 1},
        "use": {"type": "string", "minLength": 1}
      }
    },
    "test": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "kind"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "kind": {"enum": ["method", "mutate", "design"]},
        "call": {"type": "string"},
        "bindings": {
          "type": "object",
          "additionalProperties": {"type": "string"}
        },
        "args": {"type": "string"},
        "observe": {"type": "string"},
        "expected": {"type": ["string", "array"]},
        "compare": {
          "enum": ["equal", "linked_values", "tree_level", "same_node", "random_list", "none"]
        },
        "operations": {
          "type": "array",
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 2
          }
        }
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "design"}}},
          "then": {"properties": {"expected": {"type": "array"}}},
          "else": {"properties": {"expected": {"type": "string"}}}
        }
      ]
    }
  }
}

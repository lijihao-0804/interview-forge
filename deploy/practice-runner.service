[Unit]
Description=InterviewForge practice code runner (sandboxed)
After=network.target

[Service]
Type=simple
# bubblewrap needs privileged namespace setup; user code is dropped to uid 65534
# inside the private mount/network namespace.
ExecStart=/usr/bin/python3 /opt/interview-forge/tools/practice_runner.py --host 127.0.0.1 --port 8877 --token-file /etc/interview-forge/practice-runner.token
Restart=on-failure
RestartSec=2
NoNewPrivileges=false
PrivateTmp=true
ProtectHome=true

[Install]
WantedBy=multi-user.target
